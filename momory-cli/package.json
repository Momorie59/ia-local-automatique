{
  "name": "momory-cli",
  "version": "0.1.0",
  "description": "Assistant IA personnel local — équivalent local de Gemini CLI / Claude Code, entièrement contrôlé par vous.",
  "type": "module",
  "bin": {
    "momory": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "prompts": "^2.4.2",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
